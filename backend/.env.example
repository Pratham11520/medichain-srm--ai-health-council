# MediChain SRM — Backend Environment Variables
# Copy this file to .env and fill in your values.

# ── Google Gemini (Primary LLM) ──────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Ollama (Local LLM — optional) ────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ── CORS — Allowed Frontend Origins ──────────────────────────────────────
# In production, set this to your actual frontend URL (no trailing slash)
# Example: ALLOWED_ORIGINS=https://medichain.yourdomain.com
# For Docker Compose, use: http://localhost
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,http://localhost

# ── Rate Limiting ─────────────────────────────────────────────────────────
# Max AI requests per minute per IP
RATE_LIMIT_PER_MINUTE=15

# ── App Settings ──────────────────────────────────────────────────────────
APP_ENV=production
APP_VERSION=3.0.0
